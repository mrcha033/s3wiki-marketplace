{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "s3-research-memory",
  "displayName": "S3 Research Memory",
  "version": "0.1.0",
  "description": "Search and extend the lab's shared S3 Research Memory through its central MCP service.",
  "author": {
    "name": "mrcha033",
    "url": "https://github.com/mrcha033"
  },
  "homepage": "https://github.com/mrcha033/s3wiki-marketplace",
  "repository": "https://github.com/mrcha033/s3wiki-marketplace",
  "keywords": [
    "research-memory",
    "lessons",
    "evidence",
    "mcp",
    "mediawiki"
  ],
  "mcpServers": {
    "s3-research-memory": {
      "type": "http",
      "url": "https://s3wiki.yonsei.ac.kr/mcp",
      "headers": {
        "Authorization": "Bearer ${S3RM_MCP_TOKEN}"
      }
    }
  }
}
